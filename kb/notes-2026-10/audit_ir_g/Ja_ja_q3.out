== (a) un mode, k||x, eps oblique (0,cos th, sin th)
 checks: trace-That (<=s^5) = 0 ; div O(beta^0,beta^1) (<=s^4) = [(0, 0), (0, 0), (0, 0), (0, 0)] ; inconnues libres X^R : {q6, q19, q18, q15, q17, q16, q20}
 X^R_ss = C_rad*s**2 + beta*q6*s**2
  R_xsx : [beta s^0 ln s] = -kappa*(-c + k*u0)*(c + k*u0)/(2*e**2)  
  R_ysy : [beta s^0 ln s] = -kappa*(3*c**2*cos(theta)**2 - c**2 + 3*k**2*u0**2*cos(theta)**2 - 2*k**2*u0**2)/(2*e**2)  
  R_ysz : [beta s^0 ln s] = -3*kappa*(c**2 + k**2*u0**2)*sin(2*theta)/(4*e**2)  
  R_zsy : [beta s^0 ln s] = -3*kappa*(c**2 + k**2*u0**2)*sin(2*theta)/(4*e**2)  
  R_zsz : [beta s^0 ln s] = -kappa*(3*c**2*sin(theta)**2 - c**2 + 3*k**2*u0**2*sin(theta)**2 - 2*k**2*u0**2)/(2*e**2)  
  ln s a beta^0 dans R : {0}
 Q = [[0, 0, 0], [0, -c**2*cos(theta)**2/2 + k**2*u0**2*sin(theta)**2/2, -(c**2 + k**2*u0**2)*sin(2*theta)/4], [0, -(c**2 + k**2*u0**2)*sin(2*theta)/4, -c**2*sin(theta)**2/2 + k**2*u0**2*cos(theta)**2/2]]
 ecart a la loi 3 kappa/e^2 Q^TF : AUCUN ; autres composantes avec ln : {}
 ecart <X^M>_ln a (2Q - d trQ)/e^2 : AUCUN
