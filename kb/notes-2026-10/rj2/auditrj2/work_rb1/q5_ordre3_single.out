S = Omega^{s_h+s_psi-1} [A + Omega B] : True
A(s_h, s_psi) (coefficient pouvant resonner) =
    I*(2*C0*H00*s_psi + C0*H11*s_h + C0*H22*s_h + C0*H33*s_h + C2*H03*s_h + 2*C2*H03*s_psi + C3*H01*s_h + 2*C3*H01*s_psi - I*C3*H02*s_h - 2*I*C3*H02*s_psi)/4
    I*(2*C1*H00*s_psi + C1*H11*s_h + C1*H22*s_h + C1*H33*s_h + C2*H01*s_h + 2*C2*H01*s_psi + I*C2*H02*s_h + 2*I*C2*H02*s_psi - C3*H03*s_h - 2*C3*H03*s_psi)/4
    -I*(C0*H03*s_h + 2*C0*H03*s_psi + C1*H01*s_h + 2*C1*H01*s_psi - I*C1*H02*s_h - 2*I*C1*H02*s_psi + 2*C2*H00*s_psi + C2*H11*s_h + C2*H22*s_h + C2*H33*s_h)/4
    -I*(C0*H01*s_h + 2*C0*H01*s_psi + I*C0*H02*s_h + 2*I*C0*H02*s_psi - C1*H03*s_h - 2*C1*H03*s_psi + 2*C3*H00*s_psi + C3*H11*s_h + C3*H22*s_h + C3*H33*s_h)/4
A a s_h = 0 ne depend que de H00, H0i : True

